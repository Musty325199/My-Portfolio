# Environment Variables for Mustapha Lawal's Portfolio

# Production Canonical Site URL (Used for Metadata, Sitemap, Robots, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://musty-dev.vercel.app

# Google Gemini API Key for "Ask Musty's portfolio" AI assistant (Free Tier)
# Get a free key at: https://aistudio.google.com/app/apikey
# If unset, the assistant gracefully falls back to offline precomputed chips & direct contact.
GEMINI_API_KEY=

# Resend API Key for contact form direct email forwarding (Free Tier: 3,000 emails/month)
# Get a key at: https://resend.com
# If unset, the contact form automatically falls back to opening mailto: in the user's email client.
RESEND_API_KEY=
